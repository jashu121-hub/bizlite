generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  PENDING
}

enum ExpenseCostType {
  PRODUCTION
  SELLING
  OVERHEAD
}

/** Accounting purpose of an Expense row — prevents inventory/production costs from becoming OpEx. */
enum ExpenseLedgerKind {
  OPERATING
  INVENTORY_PURCHASE
  PRODUCTION_PAYMENT
  ASSET_PURCHASE
}

enum CostingMode {
  INVENTORY
  SIMPLE
}

enum ProductType {
  RESALE
  MANUFACTURED
  SERVICE
}

enum CostCalculationStatus {
  DRAFT
  SAVED
  APPLIED
}

enum InventoryDestination {
  RAW_MATERIALS
  WIP
  FINISHED_GOODS
  NONE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_REVERSAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PRODUCTION_RECEIPT
}

enum CashAccountType {
  CASH
  BANK
  OTHER
}

enum CashBalanceSource {
  OWNER_CAPITAL
  PREVIOUS_BUSINESS_BALANCE
  LOAN_RECEIVED
  OTHER_FUNDING
}

enum CashTransactionType {
  OPENING_BALANCE
  STARTING_BALANCE
  MONEY_IN
  MONEY_OUT
  TRANSFER_IN
  TRANSFER_OUT
  SALE_RECEIPT
  EXPENSE_PAYMENT
  PURCHASE_PAYMENT
  PRODUCTION_PAYMENT
  CUSTOMER_PAYMENT
  BALANCE_ADJUSTMENT
}

model UserProfile {
  id               String   @id @db.Uuid
  email            String   @unique
  businessName     String?
  ownerName        String?
  phone            String?
  currency             String   @default("AED")
  setupCompleted       Boolean  @default(false)
  expenseCostDefaults  Json?
  /** INVENTORY = sale-line unit costs (Method B). SIMPLE = period PRODUCTION expenses as COGS. */
  costingMode          CostingMode @default(INVENTORY)
  /** When false (default), stock-tracked products cannot be sold below available qty. */
  allowNegativeStock   Boolean     @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  products          Product[]
  customers         Customer[]
  sales             Sale[]
  expenses          Expense[]
  expenseCategories ExpenseCategoryItem[]
  customerPayments  CustomerPayment[]
  stockMovements    StockMovement[]
  cashAccounts      CashAccount[]
  cashTransactions  CashTransaction[]
  costCalculations  ProductCostCalculation[]

  @@index([email])
}

model CashAccount {
  id            String          @id @default(cuid())
  userId        String          @db.Uuid
  name          String
  type          CashAccountType
  bankName      String?
  accountNumber String?
  notes         String?
  isActive      Boolean         @default(true)
  currentBalance Decimal        @default(0) @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user         UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]
  sales        Sale[]
  expenses     Expense[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, type])
}

model CashTransaction {
  id            String               @id @default(cuid())
  userId        String               @db.Uuid
  accountId     String
  type          CashTransactionType
  date          DateTime             @db.Date
  /// Signed amount: positive increases balance, negative decreases it.
  amount        Decimal              @db.Decimal(14, 2)
  balanceSource CashBalanceSource?
  reference     String?
  notes         String?
  transferGroupId String?
  saleId           String?
  expenseId        String?
  stockMovementId  String?
  createdAt        DateTime             @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@index([stockMovementId])
  @@index([saleId])
  @@index([expenseId])
  @@index([transferGroupId])
}

model ExpenseCategoryItem {
  id              String           @id @default(cuid())
  userId          String           @db.Uuid
  name            String
  defaultCostType ExpenseCostType?
  isArchived      Boolean          @default(false)
  isTransport     Boolean          @default(false)
  parentId        String?
  systemKey       String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ExpenseCategoryItem?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children ExpenseCategoryItem[] @relation("CategoryChildren")
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, parentId])
  @@index([userId, systemKey])
}

model Product {
  id             String      @id @default(cuid())
  userId         String      @db.Uuid
  name           String
  category       String
  sku            String?
  productType    ProductType @default(RESALE)
  unitOfMeasure  String      @default("pcs")
  /** Current weighted-average inventory cost (valuation + COGS source). */
  costPrice      Decimal     @db.Decimal(14, 2)
  /** Optional estimated purchase cost for future stock receipts (resale). */
  defaultPurchaseCost Decimal @default(0) @db.Decimal(14, 2)
  /** Latest standard / suggested production unit cost (manufactured). */
  standardProductionCost Decimal @default(0) @db.Decimal(14, 2)
  /** Default suggested selling price for future sales only. */
  sellingPrice   Decimal     @db.Decimal(14, 2)
  openingStock   Int         @default(0)
  currentStock   Int         @default(0)
  lowStockLevel  Int         @default(5)
  notes          String?
  costBreakdown  Json?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  expenses       Expense[]
  costCalculations ProductCostCalculation[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, name])
  @@index([userId, productType])
}

model ProductCostCalculation {
  id                    String                 @id @default(cuid())
  userId                String                 @db.Uuid
  productId             String?
  name                  String
  category              String?
  quantity              Int                    @default(1)
  unit                  String                 @default("pcs")
  calculationDate       DateTime               @db.Date
  notes                 String?
  status                CostCalculationStatus  @default(DRAFT)
  payload               Json
  totalBatchCost        Decimal                @default(0) @db.Decimal(14, 2)
  costPerUnit           Decimal                @default(0) @db.Decimal(14, 2)
  suggestedSellingPrice Decimal                @default(0) @db.Decimal(14, 2)
  grossMarginPct        Decimal                @default(0) @db.Decimal(14, 2)
  expenseIds            String[]               @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([productId])
  @@index([userId, calculationDate])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments CustomerPayment[]

  @@index([userId])
  @@index([userId, name])
}

model Sale {
  id            String        @id @default(cuid())
  userId        String        @db.Uuid
  customerId    String?
  invoiceNumber String
  date          DateTime      @db.Date
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balancePending Decimal      @db.Decimal(14, 2)
  totalCost     Decimal       @db.Decimal(14, 2)
  grossProfit   Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  cashAccountId String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashAccount CashAccount?      @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    CustomerPayment[]

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([userId, date])
  @@index([userId, paymentStatus])
  @@index([customerId])
  @@index([cashAccountId])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String?
  productName     String
  quantity        Int
  unitCost        Decimal @db.Decimal(14, 2)
  unitSellingPrice Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)
  lineCost        Decimal @db.Decimal(14, 2)
  lineProfit      Decimal @db.Decimal(14, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  userId        String        @db.Uuid
  customerId    String
  saleId        String?
  date          DateTime      @db.Date
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([saleId])
  @@index([userId, date])
}

model Expense {
  id            String           @id @default(cuid())
  userId        String           @db.Uuid
  date          DateTime         @db.Date
  categoryId    String
  /** P&L cost classification for operating expenses (SELLING / OVERHEAD / legacy PRODUCTION). */
  costType      ExpenseCostType?
  /** Ledger purpose — only OPERATING reduces profit immediately. */
  ledgerKind    ExpenseLedgerKind @default(OPERATING)
  description   String
  amount        Decimal          @db.Decimal(14, 2)
  paymentMethod PaymentMethod    @default(CASH)
  cashAccountId String?
  vendor        String?
  reference     String?
  notes         String?
  /** Optional production / inventory link (PRODUCTION cost type). */
  productId             String?
  productionQuantity    Int?
  productionUnit        String?
  productionUnitCost    Decimal? @db.Decimal(14, 2)
  inventoryDestination  InventoryDestination?
  productionBatch       String?
  updateInventory       Boolean  @default(false)
  /** Links that prevent duplicate recognition of the same business cost. */
  costCalculationId     String?
  stockMovementId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ExpenseCategoryItem @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, costType])
  @@index([userId, ledgerKind])
  @@index([categoryId])
  @@index([cashAccountId])
  @@index([productId])
  @@index([costCalculationId])
  @@index([stockMovementId])
  @@index([userId, reference])
}

model StockMovement {
  id             String            @id @default(cuid())
  userId         String            @db.Uuid
  productId      String
  type           StockMovementType
  quantity       Int
  quantityBefore Int?
  quantityAfter  Int?
  /** Unit cost for this receipt/issue (absolute per unit). */
  unitCost       Decimal?          @db.Decimal(14, 2)
  /** quantity × unitCost for this movement (signed with quantity where useful). */
  totalCost      Decimal?          @db.Decimal(14, 2)
  /** Product weighted-average cost after this movement. */
  averageCostAfter Decimal?        @db.Decimal(14, 2)
  reason         String?
  reference      String?
  date           DateTime          @db.Date
  notes          String?
  saleId         String?
  createdAt      DateTime          @default(now())

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([userId, date])
  @@index([saleId])
}
